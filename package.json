{
	"name": "ha-hearth",
	"version": "0.1.17",
	"private": true,
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"check:bundle": "node scripts/check-bundle-budget.mjs",
		"check:hearth-a11y": "node scripts/check-hearth-a11y.mjs",
		"check:watch": "npm run check -- --watch",
		"test": "vitest run --coverage",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint . --max-warnings 59",
		"format": "prettier --write .",
		"matrix": "playwright test --config playwright.matrix.config.ts",
		"style:inventory": "node scripts/style-inventory.mjs",
		"check:style": "node scripts/check-style-tokens.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3-array": "^3.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/eslint": "^9.6.1",
		"@types/express": "^5.0.6",
		"@types/sortablejs": "^1.15.9",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.11"
	},
	"type": "module",
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/legacy-modes": "^6.5.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.4",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.11",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/hanken-grotesk": "^5.3.0",
		"@material-symbols/font-400": "^0.45.10",
		"@material-symbols/metadata": "^0.45.9",
		"codemirror": "6.0.2",
		"d3-array": "^3.2.4",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"dompurify": "^3.4.15",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"hls.js": "^1.7.2",
		"home-assistant-js-websocket": "^9.6.0",
		"http-proxy-middleware": "^4.2.0",
		"js-yaml": "^5.4.1",
		"marked": "^18.0.12",
		"sortablejs": "^1.15.7",
		"valibot": "^1.5.0",
		"ws": "^8.21.3"
	}
}
